# ==============================================================================
# Vyūha Infrastructure Vault Connector - Configuration Template
# Copy this file to .env and provide your cluster-specific credentials
# ==============================================================================

NODE_ENV=production
SERVICE_NAME=vyuha-infra-vault-connector
LOG_LEVEL=info

# Internal Vault Synchronization Gateway (Internal VPC or Mesh)
VAULT_INTERNAL_URL=https://vault.internal.corp/api/v2/tokens/sync

# Service Account Bearer Token (Generated via Vault AppRole auth)
VAULT_AUTH_BEARER=vyuha_sec_REPLACE_WITH_YOUR_SERVICE_ACCOUNT_TOKEN

# Webhook endpoint triggered when automated lease rotation is required
VAULT_ROTATION_HOOK=https://vault.internal.corp/v1/auth/rotate

# Cluster Identity & Namespace
VAULT_NAMESPACE=infrastructure-core
VAULT_CLUSTER_ID=cluster-us-east-alpha

# Resilience and Networking Settings
VAULT_MAX_RETRIES=3
VAULT_TIMEOUT_MS=4000
SYNC_INTERVAL_MS=300000
